// Подписка ЖурналИзмененияЦенПередЗаписью
// Источник: РегистрСведенийНаборЗаписей.ЦеныНоменклатуры, событие ПередЗаписью
Процедура ЖурналИзмененияЦенПередЗаписью(Источник, Отказ, Замещение) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	// У пользователей нет прав на журнал, он ведётся служебно
	УстановитьПривилегированныйРежим(Истина);
	
	ИдентификаторИзменения = Новый УникальныйИдентификатор;
	Набор = РегистрыСведений.ЖурналИзмененияЦен.СоздатьНаборЗаписей();
	Набор.Отбор.ИдентификаторИзменения.Установить(ИдентификаторИзменения);
	
	Для Каждого Запись Из Источник Цикл
		НоваяЗапись = Набор.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяЗапись, Запись, "Номенклатура, ВидЦены, Цена");
		НоваяЗапись.ИдентификаторИзменения = ИдентификаторИзменения;
		НоваяЗапись.ДатаЦены = Запись.Период;
		НоваяЗапись.ДатаИзменения = ТекущаяДатаСеанса();
		НоваяЗапись.Пользователь = Пользователи.ТекущийПользователь();
	КонецЦикла;
	
	Набор.Записать();
	
КонецПроцедуры
