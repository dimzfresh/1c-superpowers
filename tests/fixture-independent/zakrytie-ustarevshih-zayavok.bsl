Процедура ЗакрытьУстаревшиеЗаявкиРегламент() Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.ЗакрытиеУстаревшихЗаявок);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 500
	|	Заявка.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ЗаявкиНаЗакупку КАК Заявка
	|ГДЕ
	|	Заявка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаявок.Открыта)
	|	И Заявка.ДатаСоздания < &ГраницаАктуальности
	|	И НЕ Заявка.Ссылка В (&Пропущенные)";
	Запрос.УстановитьПараметр("ГраницаАктуальности", ТекущаяДатаСеанса() - 90 * 86400);
	Пропущенные = Новый Массив;
	
	Пока Истина Цикл
		Запрос.УстановитьПараметр("Пропущенные", Пропущенные);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		Пока Выборка.Следующий() Цикл
			// Каждая заявка отдельно: занятую пользователем пропускаем до следующего запуска
			Попытка
				ЗаявкаОбъект = Выборка.Ссылка.ПолучитьОбъект();
				ЗаявкаОбъект.Заблокировать();
				ЗаявкаОбъект.Статус = Перечисления.СтатусыЗаявок.Закрыта;
				ЗаявкаОбъект.Записать();
			Исключение
				Пропущенные.Добавить(Выборка.Ссылка);
				ЗаписьЖурналаРегистрации(НСтр("ru = 'Закрытие устаревших заявок'"), УровеньЖурналаРегистрации.Предупреждение,
					Метаданные.Справочники.ЗаявкиНаЗакупку, Выборка.Ссылка,
					ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры
