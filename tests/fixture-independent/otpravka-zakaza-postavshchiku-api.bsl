// Общий модуль ИнтеграцияСПоставщикомСервер (Сервер, без вызова сервера)

Функция ОтправитьЗаказПоставщику(ЗаказСсылка) Экспорт
	
	Настройки = Константы.НастройкиAPIПоставщика.Получить().Получить();
	
	УстановитьПривилегированныйРежим(Истина);
	Токен = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Настройки.ВладелецНастроек, "ТокенДоступа");
	УстановитьПривилегированныйРежим(Ложь);
	
	Если Не ЗначениеЗаполнено(Токен) Тогда
		ВызватьИсключение НСтр("ru = 'Не задан токен доступа к API поставщика'");
	КонецЕсли;
	
	Соединение = Новый HTTPСоединение(Настройки.Сервер, 443, , , , 30,
		Новый ЗащищенноеСоединениеOpenSSL(, Новый СертификатыУдостоверяющихЦентровОС));
	
	Запрос = Новый HTTPЗапрос("/api/v2/orders");
	Запрос.Заголовки.Вставить("Authorization", "Bearer " + Токен);
	Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Запрос.УстановитьТелоИзСтроки(ТелоЗаказаJSON(ЗаказСсылка), КодировкаТекста.UTF8,
		ИспользованиеByteOrderMark.НеИспользовать);
	
	Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	Если Ответ.КодСостояния <> 200 И Ответ.КодСостояния <> 201 Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Поставщик вернул код %1: %2'"),
			Ответ.КодСостояния, Лев(Ответ.ПолучитьТелоКакСтроку(), 1000));
	КонецЕсли;
	
	Возврат Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	
КонецФункции
