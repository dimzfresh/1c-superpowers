Функция ТекущийОтветственный() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ Настройки.Ответственный КАК Ответственный ИЗ РегистрСведений.НастройкиСлужебные КАК Настройки");
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);

	Если Выборка.Следующий() И ПравоДоступа("Чтение", Метаданные.Справочники.Пользователи) Тогда
		Возврат Выборка.Ответственный;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции
