Функция ДанныеКонтрагента(Контрагент) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ Контрагенты.ИНН КАК ИНН, Контрагенты.Комментарий КАК Комментарий ИЗ Справочник.Контрагенты КАК Контрагенты ГДЕ Контрагенты.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Контрагент);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции
