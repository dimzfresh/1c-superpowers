Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	// Явная запись движений: ниже то же проведение читает остаток уже с учётом этого документа.
	Движения.СвободныеОстатки.Записывать = Истина;
	Для Каждого Строка Из Товары Цикл
		Движение = Движения.СвободныеОстатки.ДобавитьРасход();
		Движение.Период = Дата;
		Движение.Склад = Склад;
		Движение.Номенклатура = Строка.Номенклатура;
		Движение.Количество = Строка.Количество;
	КонецЦикла;
	Движения.СвободныеОстатки.Записать();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.КоличествоОстаток КАК КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.СвободныеОстатки.Остатки(&Граница, Склад = &Склад) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток < 0";
	Запрос.УстановитьПараметр("Граница", Новый Граница(МоментВремени(), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Склад", Склад);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Сообщить("Не хватает на складе: " + Выборка.Номенклатура);
		Отказ = Истина;
	КонецЦикла;

	// Служебное чтение настройки магазина, привилегированный режим выключен до дальнейшей работы.
	УстановитьПривилегированныйРежим(Истина);
	АдресМагазина = Константы.АдресМагазина.Получить();
	УстановитьПривилегированныйРежим(Ложь);

	Если Не Отказ Тогда
		Соединение = Новый HTTPСоединение(АдресМагазина);
		Ответ = Соединение.Получить(Новый HTTPЗапрос("/orders/" + Номер + "/confirm"));
	КонецЕсли;

КонецПроцедуры
