Функция ПечатьАкта(Акт) Экспорт

	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ПолеСверху = 0;
	ТабДокумент.ПолеСлева = 0;
	ТабДокумент.ПолеСнизу = 0;
	ТабДокумент.ПолеСправа = 0;
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.Акт.ПФ_MXL_Акт");
	Если Макет.Области.Найти("Тело") <> Неопределено Тогда
		ТабДокумент.Вывести(Макет.ПолучитьОбласть("Тело"));
	КонецЕсли;
	Возврат ТабДокумент;

КонецФункции
