&НаКлиенте
Процедура ОбновитьСтатусыЭДО(Команда)
	
	ВыделенныеДокументы = Элементы.Список.ВыделенныеСтроки;
	Если ВыделенныеДокументы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Статусы = ОбменЭДОКонтур.СтатусыДокументов(ВыделенныеДокументы);
	
	Для Каждого КлючИЗначение Из Статусы Цикл
		Если КлючИЗначение.Значение.ЕстьОшибка Тогда
			ТекстОшибки = СтрШаблон(НСтр("ru = 'Документ %1: %2'"),
				КлючИЗначение.Ключ, КлючИЗначение.Значение.ТекстОшибки);
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
		КонецЕсли;
	КонецЦикла;
	
	Элементы.Список.Обновить();
	
КонецПроцедуры
