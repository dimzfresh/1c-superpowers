Процедура ПередЗаписью(Отказ)
	
	Если ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеСвойства.Вставить("ЭтоНовый", ЭтоНовый());
	
	Если Не ЗначениеЗаполнено(ДатаСогласования) И СуммаДоговора >= ПорогСогласования() Тогда
		
		Задача = Задачи.ЗадачаИсполнителя.СоздатьЗадачу();
		Задача.Дата = ТекущаяДатаСеанса();
		Задача.Наименование = СтрШаблон(НСтр("ru = 'Согласовать договор %1'"), Наименование);
		Задача.Предмет = Ссылка;
		Задача.РольИсполнителя = Справочники.РолиИсполнителей.ФинансовыйКонтролер;
		Задача.СрокИсполнения = ТекущаяДатаСеанса() + 3 * 86400;
		Задача.Записать();
		
		Статус = Перечисления.СтатусыДоговоров.НаСогласовании;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПорогСогласования()
	Возврат Константы.ПорогСогласованияДоговоров.Получить();
КонецФункции
