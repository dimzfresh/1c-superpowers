&НаКлиенте
Процедура ПроверитьКодыМаркировки(Команда)
	
	КоличествоОшибок = 0;
	
	Для Каждого СтрокаКода Из Объект.КодыМаркировки Цикл
		
		Если Не ПустаяСтрока(СтрокаКода.РезультатПроверки) Тогда
			Продолжить;
		КонецЕсли;
		
		Результат = ПроверитьКодНаСервере(СтрокаКода.КодМаркировки, Объект.Организация);
		СтрокаКода.РезультатПроверки = Результат.Статус;
		СтрокаКода.ИННВладельца = Результат.ИНН;
		
		Если Результат.ЕстьОшибка Тогда
			КоличествоОшибок = КоличествоОшибок + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	Если КоличествоОшибок > 0 Тогда
		ПоказатьПредупреждение(, СтрШаблон(НСтр("ru = 'Не прошли проверку: %1'"), КоличествоОшибок));
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьКодНаСервере(КодМаркировки, Организация)
	
	Возврат ИнтеграцияЦРПТ.СтатусКода(КодМаркировки, Организация);
	
КонецФункции
