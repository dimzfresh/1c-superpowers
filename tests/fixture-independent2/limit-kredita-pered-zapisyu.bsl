&После("ПередЗаписью")
Процедура мк_ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
		Возврат;
	КонецЕсли;
	
	ЛимитДоступен = мк_КредитныеЛимиты.ЛимитПокрываетСумму(
		Контрагент, Договор, СуммаДокумента, Ссылка);
	
	Отказ = Не ЛимитДоступен;
	
	Если Не ЛимитДоступен Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Превышен кредитный лимит по договору.'"),
			ЭтотОбъект, "Договор", "Объект");
	КонецЕсли;
	
КонецПроцедуры
