// Общий модуль ИнтеграцияСкладскойСистемыКэш

Функция ТокенДоступа() Экспорт
	
	НастройкиПодключения = ИнтеграцияСкладскойСистемы.НастройкиПодключения();
	
	HTTPСоединение = Новый HTTPСоединение(НастройкиПодключения.Сервер, , , , , 30,
		Новый ЗащищенноеСоединениеOpenSSL);
	HTTPЗапрос = Новый HTTPЗапрос("/oauth/token");
	HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	HTTPЗапрос.УстановитьТелоИзСтроки(СтрШаблон(
		"grant_type=client_credentials&client_id=%1&client_secret=%2",
		НастройкиПодключения.ИдентификаторКлиента, НастройкиПодключения.Секрет));
	
	Ответ = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не удалось получить токен: %1'"), Ответ.КодСостояния);
	КонецЕсли;
	
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
	ДанныеТокена = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	
	Возврат ДанныеТокена.access_token;
	
КонецФункции
