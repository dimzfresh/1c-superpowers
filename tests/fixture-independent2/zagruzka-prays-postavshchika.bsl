Процедура ЗагрузитьСтрокиПрайса(ТаблицаПрайса, Поставщик, ОшибкиЗагрузки) Экспорт
	
	НачатьТранзакцию();
	Попытка
		Для Каждого СтрокаПрайса Из ТаблицаПрайса Цикл
			Попытка
				МенеджерЗаписи = РегистрыСведений.ЦеныПоставщиков.СоздатьМенеджерЗаписи();
				МенеджерЗаписи.Период = СтрокаПрайса.ДатаЦены;
				МенеджерЗаписи.Поставщик = Поставщик;
				МенеджерЗаписи.Номенклатура = СтрокаПрайса.Номенклатура;
				МенеджерЗаписи.Цена = СтрокаПрайса.Цена;
				МенеджерЗаписи.Валюта = СтрокаПрайса.Валюта;
				МенеджерЗаписи.Записать();
			Исключение
				// битые строки прайса пропускаем, их потом разбирает закупщик (задача 4512)
				ОшибкиЗагрузки.Добавить(СтрШаблон("Строка %1: %2",
					СтрокаПрайса.НомерСтроки, КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
			КонецПопытки;
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры
