Процедура ПересчитатьСуммыВВалютуУчета(Документы, ДатаПересчета) Экспорт
	
	НачатьТранзакцию();
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.КурсыВалют");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Разделяемый;
		Для Каждого ДокументСсылка Из Документы Цикл
			ЭлементБлокировки = Блокировка.Добавить(ДокументСсылка.Метаданные().ПолноеИмя());
			ЭлементБлокировки.УстановитьЗначение("Ссылка", ДокументСсылка);
		КонецЦикла;
		Блокировка.Заблокировать();
		
		Курсы = КурсыВалютНаДату(ДатаПересчета);
		
		Для Каждого ДокументСсылка Из Документы Цикл
			ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
			Курс = Курсы.Получить(ДокументОбъект.ВалютаДокумента);
			Если Курс = Неопределено Тогда
				ВызватьИсключение СтрШаблон(НСтр("ru = 'Нет курса %1 на %2'"),
					ДокументОбъект.ВалютаДокумента, Формат(ДатаПересчета, "ДЛФ=D"));
			КонецЕсли;
			ДокументОбъект.СуммаУпр = Окр(ДокументОбъект.СуммаДокумента * Курс, 2);
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры
